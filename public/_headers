# Vite emits content-hashed filenames in /assets/, so they are safe to cache
# forever. Browser AND Cloudflare edge nodes will both honour `immutable` and
# never revalidate; new deploys produce new filenames.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# index.html and the dynamic /rule-changes.json must always be revalidated so
# users pick up new deploys + the weekly IANA sync without a hard refresh.
/
  Cache-Control: public, no-cache

/index.html
  Cache-Control: public, no-cache

/rule-changes.json
  Cache-Control: public, no-cache
